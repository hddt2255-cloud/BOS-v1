function replaceRowsForNpsn(sheet, colCount, targetNpsn, newRowsForSchool) {
  if (!sheet) return;
  var lastRow = sheet.getLastRow();
  var otherRows = [];

  if (lastRow > 1) {
    var existing = sheet.getRange(2, 1, lastRow - 1, colCount).getValues();
    for (var i = 0; i < existing.length; i++) {
      var rowNpsn = String(existing[i][colCount - 1] || "").trim();
      if (rowNpsn !== "" && rowNpsn !== targetNpsn) {
        otherRows.push(existing[i]);
      }
    }
    sheet.getRange(2, 1, lastRow - 1, colCount).clearContent();
  }

  var combined = otherRows.concat(newRowsForSchool || []);
  if (combined.length > 0) {
    applyPlainTextColumnsGs(sheet, sheet.getName(), combined.length);
    sheet.getRange(2, 1, combined.length, colCount).setValues(combined);
  }
}

