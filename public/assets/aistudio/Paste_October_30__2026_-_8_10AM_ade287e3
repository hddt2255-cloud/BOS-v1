    return { success: true, updatedAt: nowIso, npsn: cleanNpsn };
  } finally {
    lock.releaseLock();
  }
}

function apiGetLastUpdatedAt(npsn) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var userSheet = ss.getSheetByName(SHEET_NAMES.USERS);
  if (!userSheet || userSheet.getLastRow() <= 1) return "";
  var val = userSheet.getRange(2, 18).getValue();
  return String(val || "");
}
