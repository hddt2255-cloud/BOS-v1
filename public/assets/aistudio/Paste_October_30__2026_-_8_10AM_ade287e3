/**
 * Helper: Ambil peta sheet sekaligus dalam 1 panggilan API (sangat cepat)
 */
function getSheetMapGs(ss) {
  var sheets = ss.getSheets();
  var map = {};
  for (var i = 0; i < sheets.length; i++) {
    map[sheets[i].getName()] = sheets[i];
  }
  return map;
}

/**
 * Helper: Pulihkan Kode Kegiatan / Kode Program yang sempat diubah otomatis oleh Google Sheets menjadi Date
 */
function normalizeKodeKegiatanGs(rawVal, level, parentStdPrefix, isPerBulan) {
  if (rawVal === null || rawVal === undefined || rawVal === "") return "";
  if (rawVal instanceof Date) {
    var d = rawVal.getDate();
    var m = rawVal.getMonth() + 1;
    var y = rawVal.getFullYear();
    var dd = d < 10 ? "0" + d : "" + d;
    var mm = m < 10 ? "0" + m : "" + m;

    if (level === "kegiatan" || (parentStdPrefix && !isPerBulan)) {
      var pfx = parentStdPrefix || (y >= 2000 && y <= 2099 ? ("0" + (y - 2000)).slice(-2) : "03");
      return pfx + "." + mm + "." + dd + ".";
    }
    return mm + "." + dd + ".";
  }

  var s = String(rawVal).trim();
  var matchDate = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if (matchDate) {
    var p1 = ("0" + matchDate[1]).slice(-2);
    var p2 = ("0" + matchDate[2]).slice(-2);
    var yr = parseInt(matchDate[3], 10);
    if (level === "kegiatan" || parentStdPrefix) {
      var pfx2 = parentStdPrefix || (yr >= 2000 ? ("0" + (yr - 2000)).slice(-2) : "03");
      return pfx2 + "." + p2 + "." + p1 + ".";
    }
    return p2 + "." + p1 + ".";
  }

  return s;
}

/**
 * Memastikan kolom teks diformat sebagai plain text ('@') agar format kode rekening/kegiatan tidak rusak
 */
function applyPlainTextColumnsGs(sheet, sheetName, rowCount) {
  if (!sheet || rowCount <= 0) return;
  var colIndices = TEXT_COLUMNS_BY_SHEET[sheetName] || TEXT_COLUMNS_BY_SHEET["PERBULAN_DEFAULT"] || [];
  for (var c = 0; c < colIndices.length; c++) {
    var col = colIndices[c];
    if (col <= sheet.getMaxColumns()) {
      sheet.getRange(2, col, rowCount, 1).setNumberFormat("@");
    }
  }
}

/**
 * Inisialisasi & Pengurutan 20 Sheet
 */
function ensureAllSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) return;

  var sheetMap = getSheetMapGs(ss);

  for (var i = 0; i < ORDERED_SHEETS.length; i++) {
    var sheetName = ORDERED_SHEETS[i];
    var sheet = sheetMap[sheetName];
    var headers = SHEET_HEADERS[sheetName] || SHEET_HEADERS["PERBULAN_DEFAULT"];

    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
      sheetMap[sheetName] = sheet;
    }

    if (sheet.getLastRow() === 0) {
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      var headerRange = sheet.getRange(1, 1, 1, headers.length);
      headerRange.setFontWeight("bold");
      headerRange.setBackground("#e2e8f0");
      headerRange.setBorder(true, true, true, true, true, true);
      sheet.setFrozenRows(1);
    }

    // Role Pengguna baris pertama
    if (sheetName === SHEET_NAMES.USERS && sheet.getLastRow() === 1) {
      applyPlainTextColumnsGs(sheet, SHEET_NAMES.USERS, 1);
      sheet.appendRow([
        1,
        "Admin",
        "20231556",
        "hdt123",
        "SDIT ANNISA",
        "",
        "",
        "",
        "Kota Bekasi",
        "Jawa Barat",
        "2026",
        "BOS Reguler",
        "",
        "Bank BJB Kantor Cabang Jatiasih",
        "",
        "",
        0,
        new Date().toISOString(),
        "{}"
      ]);
    }
  }

  // Pindahkan urutan tab
  for (var idx = 0; idx < ORDERED_SHEETS.length; idx++) {
    var s = sheetMap[ORDERED_SHEETS[idx]];
    if (s) {
      try {
        ss.setActiveSheet(s);
        ss.moveActiveSheet(idx + 1);
      } catch (e) {}
    }
  }
}

/**
 * Terbilang Rupiah Helper
 */
function angkaToTerbilangGs(n) {
  var nominal = Math.abs(Math.floor(Number(n) || 0));
  if (nominal === 0) return "Nol Rupiah";
  var satuan = ["", "Satu", "Dua", "Tiga", "Empat", "Lima", "Enam", "Tujuh", "Delapan", "Sembilan", "Sepuluh", "Sebelas"];

  function bilang(val) {
    if (val < 12) return satuan[val];
    if (val < 20) return bilang(val - 10) + " Belas";
    if (val < 100) return bilang(Math.floor(val / 10)) + " Puluh " + bilang(val % 10);
    if (val < 200) return "Seratus " + bilang(val - 100);
    if (val < 1000) return bilang(Math.floor(val / 100)) + " Ratus " + bilang(val % 100);
    if (val < 2000) return "Seribu " + bilang(val - 1000);
    if (val < 1000000) return bilang(Math.floor(val / 1000)) + " Ribu " + bilang(val % 1000);
    if (val < 1000000000) return bilang(Math.floor(val / 1000000)) + " Juta " + bilang(val % 1000000);
    if (val < 1000000000000) return bilang(Math.floor(val / 1000000000)) + " Milyar " + bilang(val % 1000000000);
    return bilang(Math.floor(val / 1000000000000)) + " Triliun " + bilang(val % 1000000000000);
  }

  var hasil = bilang(nominal).replace(/\s+/g, " ").trim();
  return hasil ? hasil + " Rupiah" : "Nol Rupiah";
}

function parseIndoDateToTsGs(dateStr) {
  if (!dateStr || typeof dateStr !== "string" || !dateStr.trim()) return 0;
  var parts = dateStr.trim().split("/");
  if (parts.length === 3) {
    var d = parseInt(parts[0], 10);
    var m = parseInt(parts[1], 10) - 1;
    var y = parseInt(parts[2], 10);
    if (!isNaN(d) && !isNaN(m) && !isNaN(y)) {
      return new Date(y, m, d).getTime();
    }
  }
  return 0;
}

/**
 * ============================================================================
 * API: VERIFIKASI PASSWORD ADMIN LANGSUNG DARI SHEET "Role Pengguna" (KOLOM PASSWORD)
 * ============================================================================
 */
function apiVerifyAdminLogin(inputPass) {
  ensureAllSheets();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_NAMES.USERS);
  if (!sheet || sheet.getLastRow() <= 1) {
    return {
      success: false,
      message: "Sheet 'Role Pengguna' masih kosong. Silakan isi password langsung di Spreadsheet pada Sheet 'Role Pengguna' (Kolom PASSWORD)."
    };
  }

  var pClean = String(inputPass || "").trim();
  if (!pClean) {
    return { success: false, message: "Password wajib diisi!" };
  }

  var rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 4).getValues();
  var hasConfiguredPassword = false;

  for (var i = 0; i < rows.length; i++) {
    var rRole = String(rows[i][1] || "").trim();
    var rUser = String(rows[i][2] || "").trim();
    var rPass = String(rows[i][3] || "").trim();

    // Gunakan kolom PASSWORD (kolom D), atau fallback ke kolom C jika kolom D kosong
    var candidatePass = rPass !== "" ? rPass : rUser;
    if (!candidatePass) continue;

    hasConfiguredPassword = true;

    if (pClean === candidatePass) {
      return {
        success: true,
        role: rRole || "Admin"
      };
    }
  }

  if (!hasConfiguredPassword) {
    return {
      success: false,
      message: "Kolom PASSWORD di Sheet 'Role Pengguna' belum diisi. Silakan tulis password langsung di Spreadsheet pada Sheet 'Role Pengguna'."
    };
  }

  return {
    success: false,
    message: "Password Admin salah! Pastikan sesuai dengan password di Sheet 'Role Pengguna'."
  };
}

/**
 * Simpan perubahan User & Password Admin langsung ke Sheet "Role Pengguna"
 */
function apiUpdateAdminCredentials(newUser, newPassword) {
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    ensureAllSheets();
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName(SHEET_NAMES.USERS);
    var uClean = String(newUser || "").trim();
    var pClean = String(newPassword || "").trim();
    if (!pClean) {
      return { success: false, message: "Password baru tidak boleh kosong." };
    }
    var lastRow = sheet.getLastRow();
    applyPlainTextColumnsGs(sheet, SHEET_NAMES.USERS, Math.max(lastRow, 5));
    if (lastRow > 1) {
      if (uClean) sheet.getRange(2, 3).setValue(uClean);
      sheet.getRange(2, 4).setValue(pClean);
      if (!String(sheet.getRange(2, 2).getValue() || "").trim()) {
        sheet.getRange(2, 2).setValue("Admin");
      }
    } else {
      sheet.appendRow([
        1, "Admin", uClean || "20231556", pClean, "SDIT ANNISA",
        "", "", "", "Kota Bekasi", "Jawa Barat", "2026",
        "BOS Reguler", "", "Bank BJB Kantor Cabang Jatiasih", "", "", 0, new Date().toISOString(), "{}"
      ]);
    }
    return { success: true };
  } finally {
    lock.releaseLock();
  }
}

function apiGetAccounts() {
  ensureAllSheets();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_NAMES.USERS);
  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return [];

  var data = sheet.getRange(2, 1, lastRow - 1, 19).getValues();
  var accounts = [];
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var role = String(row[1] || "").trim();
    var userOrNpsn = String(row[2] || "").trim();
    var namaSekolah = String(row[4] || "").trim();
    if (namaSekolah === "PANEL SUPER ADMIN SIBOS" || namaSekolah === "SD NEGERI") namaSekolah = "SDIT ANNISA";
    if (userOrNpsn === "20253978" || userOrNpsn.toLowerCase() === "superadmin") userOrNpsn = "20231556";
    var kepalaSekolah = String(row[5] || "").trim();
    if (kepalaSekolah === "Administrator") kepalaSekolah = "";
    var extraCfg = {};
    try { extraCfg = JSON.parse(String(row[18] || "{}")); } catch (e) { extraCfg = {}; }
    var resolvedNpsn = extraCfg.schoolNpsn || (/^\d{6,10}$/.test(userOrNpsn) ? userOrNpsn : "");
    if (resolvedNpsn === "20253978") resolvedNpsn = "20231556";
    if (!userOrNpsn && !namaSekolah && !resolvedNpsn) continue;
    accounts.push({
      npsn: resolvedNpsn || userOrNpsn || "20231556",
      user: userOrNpsn,
      namaSekolah: namaSekolah || "SDIT ANNISA",
      kepalaSekolah: kepalaSekolah || "",
      role: role || "Admin"
    });
  }
  return accounts;
}

function apiSaveAccounts(accountsList, deletedNpsn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    ensureAllSheets();
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName(SHEET_NAMES.USERS);
    var lastRow = sheet.getLastRow();
    if (lastRow > 1 && Array.isArray(accountsList) && accountsList.length > 0) {
      var rows = sheet.getRange(2, 1, lastRow - 1, 19).getValues();
      var acc = accountsList[0];
      if (acc && rows.length > 0) {
        if (acc.namaSekolah) rows[0][4] = String(acc.namaSekolah);
        if (acc.kepalaSekolah !== undefined) rows[0][5] = String(acc.kepalaSekolah);
        applyPlainTextColumnsGs(sheet, SHEET_NAMES.USERS, rows.length);
        sheet.getRange(2, 1, rows.length, 19).setValues(rows);
      }
    }
    if (deletedNpsn) removeSchoolDataByNpsn(ss, String(deletedNpsn).trim());
    return { success: true };
  } finally {
    lock.releaseLock();
  }
}

function removeSchoolDataByNpsn(ss, targetNpsn) {
  if (!targetNpsn) return;
  for (var i = 0; i < ORDERED_SHEETS.length; i++) {
    var sName = ORDERED_SHEETS[i];
    if (sName === SHEET_NAMES.USERS) continue;
    var sh = ss.getSheetByName(sName);
    if (!sh || sh.getLastRow() <= 1) continue;
    var colCount = sh.getLastColumn();
    var data = sh.getRange(2, 1, sh.getLastRow() - 1, colCount).getValues();
    var kept = [];
    for (var r = 0; r < data.length; r++) {
      if (String(data[r][colCount - 1] || "").trim() !== targetNpsn) kept.push(data[r]);
    }
    sh.getRange(2, 1, sh.getLastRow() - 1, colCount).clearContent();
    if (kept.length > 0) {
      applyPlainTextColumnsGs(sh, sName, kept.length);
      sh.getRange(2, 1, kept.length, colCount).setValues(kept);
    }
  }
}

